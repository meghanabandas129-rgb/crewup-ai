JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,https://your-site.vercel.app
DATABASE_PATH=./crewup.db
# Optional local model (install Ollama and pull the model separately)
AI_ENABLED=false
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434/api/chat
# Before public deployment set JWT_SECRET to a strong, unique value.
# Managed PostgreSQL migration materials are in deployment/postgres_schema.sql.
